# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Asia/Kolkata

# PostgreSQL (required by django-tenants)
DB_NAME=talentflow
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# LLM client (pluggable — swap provider by changing these only)
# DeepSeek (default): https://api.deepseek.com/v1 , model deepseek-chat
# OpenAI:            https://api.openai.com/v1 , model gpt-4o-mini
LLM_PROVIDER=deepseek
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# DigiLocker: keep True during Phase I dev (mock), flip False when real
DIGILOCKER_MOCK=True
DIGILOCKER_API_KEY=

# Aadhaar e-KYC: keep True during dev (mock), flip False when UIDAI credentials exist
AADHAAR_MOCK=True
AADHAAR_AUA_ID=
AADHAAR_KUA_ID=

# NCS Employment Exchange feed: keep True during dev (mock), flip False when real
NCS_MOCK=True
NCS_API_BASE=
NCS_API_KEY=

# --- Phase 1: Celery / async processing (Redis broker) ---
# Leave empty + Django DEBUG=True to run tasks synchronously (dev fallback).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Phase 1: PII encryption (Fernet key, 32-byte urlsafe base64) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When unset, a dev key is derived from DJANGO_SECRET_KEY (dev only — set it in production).
DJANGO_ENCRYPTION_KEY=
