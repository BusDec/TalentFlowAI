# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Asia/Kolkata

# PostgreSQL (required by django-tenants)
DB_NAME=talentflow
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# LLM client (pluggable — swap provider by changing these only)
# DeepSeek (default): https://api.deepseek.com/v1 , model deepseek-chat
# OpenAI:            https://api.openai.com/v1 , model gpt-4o-mini
LLM_PROVIDER=deepseek
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# DigiLocker: keep True during Phase I dev (mock), flip False when real
DIGILOCKER_MOCK=True
