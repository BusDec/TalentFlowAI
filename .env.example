# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,neepco.localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Kolkata

# ── django-tenants schema layout ─────────────────────────────────────────────
# Local dev uses the public schema and the neepco tenant schema.
# Production uses PUBLIC_SCHEMA_NAME=talentflow and DEMO_TENANT_SCHEMA=tf_neepco.
PUBLIC_SCHEMA_NAME=public
DEMO_TENANT_SCHEMA=neepco
PRIMARY_DOMAIN=neepco.localhost

# ── PostgreSQL (required by django-tenants) ─────────────────────────────────
DB_NAME=talentflow
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=
DB_CONN_MAX_AGE=0

# ── Supabase Storage (S3-compatible) ─────────────────────────────────────────
# Generate an access key pair in Supabase: Storage -> S3.
# Leave blank to use local MEDIA_ROOT in development.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ap-south-1
SUPABASE_STORAGE_BUCKET=talentflow-media
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# ── LLM client (pluggable — swap provider by changing these only) ────────────
# DeepSeek (default): https://api.deepseek.com/v1 , model deepseek-chat
# OpenAI:            https://api.openai.com/v1 , model gpt-4o-mini
LLM_PROVIDER=deepseek
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ── External integrations (leave mocked for the demo) ───────────────────────
DIGILOCKER_MOCK=True
DIGILOCKER_API_KEY=
AADHAAR_MOCK=True
AADHAAR_AUA_ID=
AADHAAR_KUA_ID=
NCS_MOCK=True
NCS_API_BASE=
NCS_API_KEY=

# ── Celery ───────────────────────────────────────────────────────────────────
# Vercel has no worker: eager mode runs tasks inside the request.
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
CELERY_TASK_ALWAYS_EAGER=True

# ── PII encryption (Fernet key, 32-byte urlsafe base64) ──────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DJANGO_ENCRYPTION_KEY=

# ── Notifications ────────────────────────────────────────────────────────────
NOTIFY_PROVIDER=console
