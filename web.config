<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="FastCgiModule" scriptProcessor="D:\home\Python312\python.exe|D:\home\Python312\Scripts\gunicorn.exe config.wsgi:application" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <caching enabled="false" />
  </system.webServer>
