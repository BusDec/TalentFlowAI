# Azure Production Environment Template
# Copy to .env and fill in real values before deploying.
# NEVER commit .env to git.

# Django
DJANGO_SECRET_KEY=<generate-with-python-c-decure-generate-secret-key>
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tf-neepco-prod.azurewebsites.net
CSRF_TRUSTED_ORIGINS=https://tf-neepco-prod.azurewebsites.net

# PostgreSQL (Azure Flexible Server)
DB_NAME=talentflow
DB_USER=talentflowadmin
DB_PASSWORD=<strong-password>
DB_HOST=tf-neepco-db.postgres.database.azure.com
DB_PORT=5432
DB_SSLMODE=require

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=tfneepcostorage
AZURE_STORAGE_KEY=<storage-account-key>
AZURE_STORAGE_CONTAINER=resumes

# Redis (Azure Cache for Redis)
CELERY_BROKER_URL=rediss://:<redis-key>@tf-neepco-redis.redis.cache.windows.net:6380/0?ssl_cert_reqs=required
CELERY_RESULT_BACKEND=rediss://:<redis-key>@tf-neepco-redis.redis.cache.windows.net:6380/0?ssl_cert_reqs=required
CELERY_TASK_ALWAYS_EAGER=False

# PII Encryption (generate once, store securely)
DJANGO_ENCRYPTION_KEY=<fernet-key>

# LLM (optional — agents degrade without it)
LLM_PROVIDER=deepseek
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=<your-key>
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# External integrations (leave empty to use mocks)
DIGILOCKER_MOCK=True
AADHAAR_MOCK=True
NCS_MOCK=True
NOTIFY_PROVIDER=console
