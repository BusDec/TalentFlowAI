# Vercel + Supabase Production Environment Template
# Copy these values into Vercel -> Project -> Settings -> Environment Variables.
# NEVER commit real secrets.

# Django
DJANGO_SECRET_KEY=<generate-with-python-c-django-generate-secret-key>
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=talentflow-ai-liard.vercel.app,.vercel.app
CSRF_TRUSTED_ORIGINS=https://talentflow-ai-liard.vercel.app,https://*.vercel.app
DJANGO_TIME_ZONE=Asia/Kolkata

# Isolated TalentFlow schemas inside the shared Supabase project.
# Shared tables: talentflow.*   Tenant tables: tf_neepco.*
PUBLIC_SCHEMA_NAME=talentflow
DEMO_TENANT_SCHEMA=tf_neepco
PRIMARY_DOMAIN=talentflow-ai-liard.vercel.app

# PostgreSQL (Supabase session pooler, IPv4; Vercel functions are IPv4-only)
DB_NAME=postgres
DB_USER=talentflow_app.ovqmhbnrkdwuumpyxntf
DB_PASSWORD=<talentflow-app-password>
DB_HOST=aws-1-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=0

# Supabase Storage (REST backend; no S3 keys required)
# The access token is a private header enforced by an RLS policy on
# storage.objects. The bucket itself is public-read for demo file URLs.
SUPABASE_URL=https://ovqmhbnrkdwuumpyxntf.supabase.co
SUPABASE_ANON_KEY=<legacy-anon-key>
SUPABASE_STORAGE_ACCESS_TOKEN=<private-storage-header-token>
SUPABASE_STORAGE_BUCKET=talentflow-media

# Optional S3 fallback (only used if the three variables above are unset)
SUPABASE_S3_ENDPOINT=https://ovqmhbnrkdwuumpyxntf.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=ap-south-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# LLM (optional — agents degrade to deterministic mode without it)
LLM_PROVIDER=deepseek
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=<your-key>
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# External integrations (mocked for the demo)
DIGILOCKER_MOCK=True
AADHAAR_MOCK=True
NCS_MOCK=True
NOTIFY_PROVIDER=console

# Celery (Vercel has no worker)
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
CELERY_TASK_ALWAYS_EAGER=True

# PII encryption — generate once and never change it after seeding.
DJANGO_ENCRYPTION_KEY=<fernet-key>

# Container port (Dockerfile.vercel)
PORT=8000
